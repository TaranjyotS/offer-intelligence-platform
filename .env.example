APP_NAME="Offer Intelligence Platform"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
PREDICTION_CONCURRENCY=5

# Auth: demo JWT for portfolio usage; swap with OAuth/OIDC in production.
AUTH_MODE=demo_jwt
DEMO_USERNAME=admin
DEMO_PASSWORD=demo123

# Local development can omit JWT_SECRET; the backend will generate a temporary one.
# Production must use a stable secret. Generate one with:
# python scripts/generate_jwt_secret.py
JWT_SECRET=
JWT_ISSUER=offer-intelligence-platform
JWT_AUDIENCE=offer-intelligence-dashboard
JWT_ACCESS_TOKEN_MINUTES=60
OAUTH_ISSUER_URL=
OAUTH_AUDIENCE=
